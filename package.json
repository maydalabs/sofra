{
  "name": "sofra",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:up": "docker start sofra-pg 2>/dev/null || docker run -d --name sofra-pg -e POSTGRES_PASSWORD=sofra_local_dev -e POSTGRES_USER=sofra -e POSTGRES_DB=sofra -p 54329:5432 postgres:18-alpine",
    "db:down": "docker stop sofra-pg",
    "db:migrate": "node --env-file-if-exists=.env.local db/migrate.mjs",
    "db:reset": "node --env-file-if-exists=.env.local db/migrate.mjs --reset",
    "db:migrate:neon": "node --env-file=.env.neon db/migrate.mjs",
    "db:types": "node --env-file-if-exists=.env.local db/generate-types.mjs && prettier --write src/server/database/database.types.ts",
    "db:fixtures": "node --env-file-if-exists=.env.local db/fixtures.mjs",
    "test:integration": "vitest run --config vitest.integration.config.ts"
  },
  "dependencies": {
    "@googlemaps/js-api-loader": "^2.1.1",
    "@hookform/resolvers": "^5.7.1",
    "@sentry/nextjs": "^10.69.0",
    "better-auth": "^1.7.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.28.0",
    "next": "16.2.12",
    "next-intl": "^4.13.4",
    "pg": "^8.23.0",
    "postgres": "^3.4.9",
    "posthog-js": "^1.409.5",
    "radix-ui": "^1.6.7",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-hook-form": "^7.84.0",
    "resend": "^6.18.1",
    "shadcn": "^4.16.1",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.0.5",
    "eslint": "^9",
    "eslint-config-next": "16.2.12",
    "jsdom": "^30.0.1",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.10"
  }
}
