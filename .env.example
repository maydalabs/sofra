# Application
NEXT_PUBLIC_APP_URL=http://localhost:3000
SOFRA_DEMO_MODE=true
SOFRA_ALLOW_INDEXING=false

# Database
#
# .env.local points at the LOCAL container so `pnpm dev` can never reach a
# deployed database by accident. Start it with `pnpm db:up`.
DATABASE_URL=postgres://sofra:sofra_local_dev@127.0.0.1:54329/sofra

# The direct (non-pooled) string, preferred for migrations because a transaction
# pooler does not support the session-level locks DDL can take. Leave empty
# locally and the runner falls back to DATABASE_URL.
DATABASE_URL_UNPOOLED=

# Deployed (Neon) credentials live in a separate, gitignored .env.neon, read
# only by `pnpm db:migrate:neon`:
#
#   DATABASE_URL=postgresql://USER:PASSWORD@ep-xxx-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require
#   DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@ep-xxx.eu-central-1.aws.neon.tech/neondb?sslmode=require
#
# In Vercel, set DATABASE_URL to the POOLED string (serverless functions exhaust
# direct connections quickly).

# Auth. Generate a secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=

# Local/test payment simulation. The production runtime rejects this provider.
SOFRA_ENABLE_MOCK_PAYMENTS=false

# iyzico (docs/PAYMENT_DECISION.md). With both keys set, the real adapter is
# selected and SOFRA_ENABLE_MOCK_PAYMENTS is ignored. The base URL defaults to
# the sandbox; set https://api.iyzipay.com only for a production deployment.
IYZICO_API_KEY=
IYZICO_SECRET_KEY=
IYZICO_BASE_URL=

# Optional adapters
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
RESEND_API_KEY=
RESEND_FROM_EMAIL=
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
